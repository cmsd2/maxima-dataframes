/* Tests for dataframes */

/* load the package */
(load("dataframes"), true);
true;

/* test helper: float close comparison */
(isclose(a, b, [opts]) := block([tol],
  tol : if length(opts) > 0 then first(opts) else 1e-10,
  is(abs(float(a) - float(b)) <= tol)), true);
true;

/* === String column creation === */

/* create from list of strings */
(sc : df_string_column(["a", "b", "c"]), true);
true;

/* predicate */
df_string_column_p(sc);
true;

/* not a string column */
df_string_column_p(42);
false;

/* length */
df_string_column_length(sc);
3;

/* ref (1-indexed) */
df_string_column_ref(sc, 1);
"a";

df_string_column_ref(sc, 3);
"c";

/* convert back to list */
df_to_string_list(sc);
["a", "b", "c"];

/* === Table with numeric columns only === */

(x_arr : ndarray([1.0, 2.0, 3.0]),
 y_arr : ndarray([4.0, 5.0, 6.0]),
 T1 : df_table(["x", "y"], [x_arr, y_arr]),
 true);
true;

df_table_shape(T1);
[3, 2];

df_table_names(T1);
["x", "y"];

/* extract column */
(col_x : df_table_column(T1, "x"), ndarray_p(col_x));
true;

/* === Table with mixed columns === */

(name_sc : df_string_column(["x", "y", "z"]),
 val_arr : ndarray([1.0, 2.0, 3.0]),
 T2 : df_table(["name", "value"], [name_sc, val_arr]),
 true);
true;

df_table_shape(T2);
[3, 2];

df_table_names(T2);
["name", "value"];

/* string column extraction */
(name_col : df_table_column(T2, "name"), df_string_column_p(name_col));
true;

/* numeric column extraction */
(val_col : df_table_column(T2, "value"), ndarray_p(val_col));
true;

/* === Table head === */

(T3 : df_table_head(T2, 2), true);
true;

df_table_shape(T3);
[2, 2];

/* head preserves string data */
(head_names : df_table_column(T3, "name"),
 df_to_string_list(head_names));
["x", "y"];

/* === Table to ndarray (numeric columns only) === */

(A : df_table_to_ndarray(T1), true);
true;

np_shape(A);
[3, 2];

/* === ndarray to table === */

(T4 : df_ndarray_to_table(np_eye(3), ["a", "b", "c"]), true);
true;

df_table_shape(T4);
[3, 3];

df_table_names(T4);
["a", "b", "c"];

/* === Empty string column === */

(sc0 : df_string_column([]), true);
true;

df_string_column_length(sc0);
0;

df_to_string_list(sc0);
[];

/* === Error cases === */

/* out of bounds ref */
errcatch(df_string_column_ref(sc, 0));
[];

errcatch(df_string_column_ref(sc, 4));
[];

/* column not found */
errcatch(df_table_column(T1, "nonexistent"));
[];

/* === Column aggregation functions === */

/* df_count on ndarray */
(a8 : ndarray([3.0, 1.0, 4.0, 1.0, 5.0, 9.0, 2.0, 6.0]), true);
true;

df_count(a8);
8;

/* df_count on string column */
(sc6 : df_string_column(["a", "b", "a", "c", "b", "a"]), true);
true;

df_count(sc6);
6;

/* df_median odd count */
df_median(ndarray([3.0, 1.0, 2.0]));
2.0;

/* df_median even count */
df_median(ndarray([4.0, 1.0, 3.0, 2.0]));
2.5;

/* df_median single element */
df_median(ndarray([7.0]));
7.0;

/* df_quantile */
df_quantile(a8, 0.0);
1.0;

df_quantile(a8, 1.0);
9.0;

df_quantile(a8, 0.5);
3.5;

/* isclose */
isclose(1.0, 1.0);
true;

isclose(1.0, 2.0);
false;

isclose(1.0, 1.05, 0.1);
true;

isclose(1.0, 1.2, 0.1);
false;

/* df_quantile 25th and 75th */
isclose(df_quantile(a8, 0.25), 1.75);
true;

isclose(df_quantile(a8, 0.75), 5.25);
true;

/* df_unique */
(u : df_unique(sc6), df_string_column_p(u));
true;

df_string_column_length(df_unique(sc6));
3;

df_to_string_list(df_unique(sc6));
["a", "b", "c"];

/* df_nunique on string column */
df_nunique(sc6);
3;

/* df_nunique on ndarray */
df_nunique(ndarray([1.0, 2.0, 1.0, 3.0, 2.0]));
3;

/* df_value_counts */
(vc : df_value_counts(sc6), df_table_p(vc));
true;

df_table_shape(vc);
[3, 2];

df_table_names(vc);
["value", "count"];

/* top value should be "a" with count 3 */
df_string_column_ref(df_table_column(vc, "value"), 1);
"a";

np_to_list(df_table_column(vc, "count"));
[3.0, 2.0, 1.0];

/* === df_describe === */

(prices : ndarray([10.0, 20.0, 30.0, 40.0, 50.0]),
 names5 : df_string_column(["A", "B", "C", "D", "E"]),
 Td : df_table(["name", "price"], [names5, prices]),
 D : df_describe(Td),
 true);
true;

/* shape: 8 stats, 2 columns (stat + price) */
df_table_shape(D);
[8, 2];

df_table_names(D);
["stat", "price"];

/* stat labels */
df_to_string_list(df_table_column(D, "stat"));
["count", "mean", "std", "min", "25%", "50%", "75%", "max"];

/* check count = 5 */
(desc_vals : np_to_list(df_table_column(D, "price")),
 is(first(desc_vals) = 5.0));
true;

/* check mean = 30 */
is(second(desc_vals) = 30.0);
true;

/* check min = 10 */
is(fourth(desc_vals) = 10.0);
true;

/* check median (50%) = 30 */
is(sixth(desc_vals) = 30.0);
true;

/* check max = 50 */
is(eighth(desc_vals) = 50.0);
true;

/* df_describe skips string columns */
(Td2 : df_table(["x", "label", "y"],
                 [ndarray([1.0, 2.0]), df_string_column(["a", "b"]), ndarray([3.0, 4.0])]),
 D2 : df_describe(Td2),
 true);
true;

df_table_names(D2);
["stat", "x", "y"];

/* === Cross-validation against Maxima descriptive package === */

(load("descriptive"), true);
true;

/* Test dataset 1: a8 = [3.0, 1.0, 4.0, 1.0, 5.0, 9.0, 2.0, 6.0] */
(data1 : [3.0, 1.0, 4.0, 1.0, 5.0, 9.0, 2.0, 6.0], true);
true;

/* median matches */
is(df_median(a8) = median(data1));
true;

/* quantile 0.25 matches */
isclose(df_quantile(a8, 0.25), quantile(data1, 0.25));
true;

/* quantile 0.5 matches */
isclose(df_quantile(a8, 0.5), quantile(data1, 0.5));
true;

/* quantile 0.75 matches */
isclose(df_quantile(a8, 0.75), quantile(data1, 0.75));
true;

/* mean matches (via df_describe) */
isclose(np_mean(a8), mean(data1));
true;

/* Test dataset 2: prices = [10.0, 20.0, 30.0, 40.0, 50.0] */
(data2 : [10.0, 20.0, 30.0, 40.0, 50.0], true);
true;

/* df_describe std matches std1 (sample, n-1) */
(D_prices : df_describe(Td),
 price_stats : np_to_list(df_table_column(D_prices, "price")),
 isclose(third(price_stats), std1(data2)));
true;

/* df_describe mean matches */
isclose(second(price_stats), mean(data2));
true;

/* df_describe median matches */
isclose(sixth(price_stats), median(data2));
true;

/* df_describe 25% matches quantile */
isclose(fifth(price_stats), quantile(data2, 0.25));
true;

/* df_describe 75% matches quantile */
isclose(seventh(price_stats), quantile(data2, 0.75));
true;

/* Test dataset 3: larger odd-length dataset */
(data3 : [2.0, 7.0, 1.0, 8.0, 3.0, 6.0, 4.0, 9.0, 5.0],
 a9 : ndarray(data3), true);
true;

isclose(df_median(a9), median(data3));
true;

isclose(df_quantile(a9, 0.25), quantile(data3, 0.25));
true;

isclose(df_quantile(a9, 0.75), quantile(data3, 0.75));
true;

/* error cases */
errcatch(df_median(ndarray([])));
[];

errcatch(df_quantile(a8, 1.5));
[];

/* ================================================================ */
/* === Phase 2: df_filter, df_select, df_arrange, df_slice, df_rename === */
/* ================================================================ */

(Tm : df_table(["name", "price"],
               [df_string_column(["A","B","C","D"]),
                ndarray([10.0, 30.0, 20.0, 40.0])]),
 true);
true;

/* --- df_filter --- */

(Tf : df_filter(Tm, lambda([price], is(price > 15))), true);
true;

df_table_shape(Tf);
[3, 2];

/* filtered names should be B, C, D */
df_to_string_list(df_table_column(Tf, "name"));
["B", "C", "D"];

/* filter keeps no rows */
df_table_shape(df_filter(Tm, lambda([price], is(price > 100))));
[0, 2];

/* filter keeps all rows */
df_table_shape(df_filter(Tm, lambda([price], is(price > 0))));
[4, 2];

/* multi-column filter */
(Tf2 : df_filter(Tm, lambda([name, price], is(price > 15) and name # "D")),
 df_to_string_list(df_table_column(Tf2, "name")));
["B", "C"];

/* --- df_select --- */

(Ts : df_select(Tm, ["price"]), true);
true;

df_table_shape(Ts);
[4, 1];

df_table_names(Ts);
["price"];

/* reorder columns */
df_table_names(df_select(Tm, ["price", "name"]));
["price", "name"];

/* --- df_arrange --- */

(Ta : df_arrange(Tm, "price"), true);
true;

df_to_string_list(df_table_column(Ta, "name"));
["A", "C", "B", "D"];

np_to_list(df_table_column(Ta, "price"));
[10.0, 20.0, 30.0, 40.0];

/* descending */
(Tad : df_arrange(Tm, "price", descending), true);
true;

df_to_string_list(df_table_column(Tad, "name"));
["D", "B", "C", "A"];

/* arrange by string column */
(Tas : df_arrange(Tm, "name", descending), true);
true;

df_to_string_list(df_table_column(Tas, "name"));
["D", "C", "B", "A"];

/* --- df_slice --- */

(Tsl : df_slice(Tm, [2, 4]), true);
true;

df_table_shape(Tsl);
[2, 2];

df_to_string_list(df_table_column(Tsl, "name"));
["B", "D"];

/* --- df_rename --- */

(Tr : df_rename(Tm, "price", "cost"), true);
true;

df_table_names(Tr);
["name", "cost"];

/* ================================================================ */
/* === Phase 3: df_mutate, df_summarize === */
/* ================================================================ */

/* --- df_mutate --- */

/* add new column */
(Tmu : df_mutate(Tm, "double", lambda([price], 2 * price)), true);
true;

df_table_shape(Tmu);
[4, 3];

df_table_names(Tmu);
["name", "price", "double"];

np_to_list(df_table_column(Tmu, "double"));
[20.0, 60.0, 40.0, 80.0];

/* replace existing column */
(Tmu2 : df_mutate(Tm, "price", lambda([price], price + 1)), true);
true;

df_table_names(Tmu2);
["name", "price"];

np_to_list(df_table_column(Tmu2, "price"));
[11.0, 31.0, 21.0, 41.0];

/* multi-column mutate */
(Tm2 : df_table(["x", "y"], [ndarray([1.0, 2.0, 3.0]), ndarray([10.0, 20.0, 30.0])]),
 Tmu3 : df_mutate(Tm2, "sum", lambda([x, y], x + y)),
 np_to_list(df_table_column(Tmu3, "sum")));
[11.0, 22.0, 33.0];

/* --- df_summarize --- */

(Tsu : df_summarize(Tm, "avg", lambda([price], np_mean(price)),
                         "n",   lambda([price], df_count(price))),
 true);
true;

df_table_shape(Tsu);
[1, 2];

df_table_names(Tsu);
["avg", "n"];

isclose(first(np_to_list(df_table_column(Tsu, "avg"))), 25.0);
true;

isclose(first(np_to_list(df_table_column(Tsu, "n"))), 4.0);
true;

/* ================================================================ */
/* === Phase 4: df_group_by + grouped summarize === */
/* ================================================================ */

(Tg : df_table(["region", "product", "revenue"],
               [df_string_column(["N","S","N","S","N"]),
                df_string_column(["a","b","c","d","e"]),
                ndarray([10.0, 20.0, 30.0, 40.0, 50.0])]),
 true);
true;

(G : df_group_by(Tg, "region"), true);
true;

/* grouped summarize */
(Gs : df_summarize(G, "total", lambda([revenue], np_sum(revenue)),
                      "avg",   lambda([revenue], np_mean(revenue))),
 true);
true;

df_table_shape(Gs);
[2, 3];

df_table_names(Gs);
["region", "total", "avg"];

/* N group: 10+30+50=90, avg=30 */
/* S group: 20+40=60, avg=30 */
(gs_regions : df_to_string_list(df_table_column(Gs, "region")),
 gs_totals : np_to_list(df_table_column(Gs, "total")),
 is(first(gs_regions) = "N"));
true;

isclose(first(gs_totals), 90.0);
true;

isclose(second(gs_totals), 60.0);
true;

/* ================================================================ */
/* === df_distinct === */
/* ================================================================ */

(Tdup : df_table(["x", "y"],
                 [df_string_column(["a","b","a","b","c"]),
                  ndarray([1.0, 2.0, 1.0, 2.0, 3.0])]),
 true);
true;

df_table_shape(df_distinct(Tdup));
[3, 2];

/* distinct by single column */
df_table_shape(df_distinct(Tdup, ["x"]));
[3, 2];

/* ================================================================ */
/* === Phase 5: joins and binds === */
/* ================================================================ */

(Tj1 : df_table(["id", "name"],
                [df_string_column(["1","2","3"]),
                 df_string_column(["Alice","Bob","Charlie"])]),
 Tj2 : df_table(["id", "score"],
                [df_string_column(["1","2","4"]),
                 ndarray([90.0, 80.0, 70.0])]),
 true);
true;

/* --- df_inner_join --- */

(Tij : df_inner_join(Tj1, Tj2, "id"), true);
true;

df_table_shape(Tij);
[2, 3];

df_table_names(Tij);
["id", "name", "score"];

df_to_string_list(df_table_column(Tij, "name"));
["Alice", "Bob"];

np_to_list(df_table_column(Tij, "score"));
[90.0, 80.0];

/* --- df_left_join --- */

(Tlj : df_left_join(Tj1, Tj2, "id"), true);
true;

df_table_shape(Tlj);
[3, 3];

/* Charlie has no match, score should be 0 (fill value) */
(lj_scores : np_to_list(df_table_column(Tlj, "score")),
 isclose(third(lj_scores), 0.0));
true;

/* --- df_bind_rows --- */

(Tb1 : df_table(["x"], [ndarray([1.0, 2.0])]),
 Tb2 : df_table(["x"], [ndarray([3.0, 4.0])]),
 Tbr : df_bind_rows(Tb1, Tb2),
 true);
true;

df_table_shape(Tbr);
[4, 1];

np_to_list(df_table_column(Tbr, "x"));
[1.0, 2.0, 3.0, 4.0];

/* bind_rows with string columns */
(Tbs1 : df_table(["name"], [df_string_column(["a","b"])]),
 Tbs2 : df_table(["name"], [df_string_column(["c","d"])]),
 Tbsr : df_bind_rows(Tbs1, Tbs2),
 df_to_string_list(df_table_column(Tbsr, "name")));
["a", "b", "c", "d"];

/* --- df_bind_cols --- */

(Tbc : df_bind_cols(df_table(["x"], [ndarray([1.0, 2.0])]),
                     df_table(["y"], [ndarray([3.0, 4.0])])),
 true);
true;

df_table_shape(Tbc);
[2, 2];

df_table_names(Tbc);
["x", "y"];

/* --- Error cases --- */

/* bind_rows: mismatched names */
errcatch(df_bind_rows(df_table(["x"], [ndarray([1.0])]),
                       df_table(["y"], [ndarray([1.0])])));
[];

/* bind_cols: mismatched row counts */
errcatch(df_bind_cols(df_table(["x"], [ndarray([1.0, 2.0])]),
                       df_table(["y"], [ndarray([1.0])])));
[];

/* bind_cols: duplicate column names */
errcatch(df_bind_cols(df_table(["x"], [ndarray([1.0])]),
                       df_table(["x"], [ndarray([1.0])])));
[];

/* select: column not found */
errcatch(df_select(Tm, ["nonexistent"]));
[];

/* slice: out of bounds */
errcatch(df_slice(Tm, [0]));
[];

errcatch(df_slice(Tm, [5]));
[];
