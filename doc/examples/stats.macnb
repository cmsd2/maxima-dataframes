  {
   "cell_type": "markdown",
   "source": [
    "## 6. Sorting"
   ],
   "metadata": {}
  },
  {
   "cell_type": "code",
   "source": [
    "/* Sort by price ascending */\n",
    "df_arrange(sales, \"price\");"
   ],
   "metadata": {
    "outputLabel": "%o293",
    "executionCount": 36
   },
   "execution_count": 36,
   "outputs": [
    {
     "output_type": "execute_result",
     "data": {
      "text/latex": [
       "\\begin{array}{llll} \\textbf{region} & \\textbf{product} & \\textbf{price} & \\textbf{qty} \\\\\\\\ \\textit{str} & \\textit{str} & \\textit{f64} & \\textit{f64} \\\\\\\\ \\hline \\text{North} & \\text{Widget} & 12.50     & 100.0     \\\\\\\\ \\text{North} & \\text{Widget} & 13.00     & 110.0     \\\\\\\\ \\text{East} & \\text{Widget} & 13.50     & 95.00     \\\\\\\\ \\text{East} & \\text{Widget} & 14.00     & 90.00     \\\\\\\\ \\text{East} & \\text{Widget} & 14.50     & 85.00     \\\\\\\\ \\text{South} & \\text{Widget} & 15.00     & 80.00     \\\\\\\\ \\text{South} & \\text{Widget} & 16.00     & 75.00     \\\\\\\\ \\text{South} & \\text{Gadget} & 20.00     & 55.00     \\\\\\\\ \\text{South} & \\text{Gadget} & 21.50     & 50.00     \\\\\\\\ \\text{North} & \\text{Gadget} & 22.00     & 45.00     \\\\\\\\ \\text{East} & \\text{Gadget} & 23.00     & 40.00     \\\\\\\\ \\text{North} & \\text{Gadget} & 24.00     & 35.00     \\\\\\\\ \\hline \\text{12 rows} \\times \\text{4 cols} \\end{array}"
