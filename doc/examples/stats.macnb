       "\\begin{array}{llll} \\textbf{region} & \\textbf{product} & \\textbf{price} & \\textbf{qty} \\\\\\\\ \\textit{str} & \\textit{str} & \\textit{f64} & \\textit{f64} \\\\\\\\ \\hline \\text{North} & \\text{Widget} & 12.50     & 100.0     \\\\\\\\ \\text{South} & \\text{Widget} & 15.00     & 80.00     \\\\\\\\ \\text{North} & \\text{Gadget} & 22.00     & 45.00     \\\\\\\\ \\text{East} & \\text{Widget} & 14.00     & 90.00     \\\\\\\\ \\text{South} & \\text{Gadget} & 21.50     & 50.00     \\\\\\\\ \\hline \\text{5 rows} \\times \\text{4 cols} \\end{array}"
