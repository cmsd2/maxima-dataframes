   ]
  },
  {
   "cell_type": "markdown",
   "source": [
    "## 3. Column-Level Statistics\n",
    "\n",
    "Individual column aggregations — the building blocks for summaries."
   ],
   "metadata": {}
  },
  {
   "cell_type": "code",
   "source": [
    "price_col : df_table_column(sales, \"price\")$\n",
    "\n",
    "print(\"Count:\", df_count(price_col))$\n",
    "print(\"Mean:\", np_mean(price_col))$\n",
    "print(\"Median:\", df_median(price_col))$\n",
    "print(\"Min:\", np_min(price_col))$\n",
    "print(\"Max:\", np_max(price_col))$\n",
    "print(\"Std:\", np_std(price_col))$"
   ],
   "metadata": {
    "outputLabel": "%o244",
    "executionCount": 26
   },
   "execution_count": 26,
   "outputs": [
    {
     "output_type": "execute_result",
     "data": {
      "text/plain": [
       "Count: 12\n",
       "Mean: 17.416666666666668\n",
       "Median: 15.5\n",
       "Min: 12.5\n",
       "Max: 24.0\n",
       "Std: 4.1424295072121895"
      ]
     },
     "metadata": {},
     "execution_count": null
    }
   ]
  },
  {
   "cell_type": "markdown",
   "source": [
    "### Quantiles"
   ],
   "metadata": {}
  },
  {
   "cell_type": "code",
   "source": [
    "print(\"Q25:\", df_quantile(price_col, 0.25))$\n",
    "print(\"Q50:\", df_quantile(price_col, 0.50))$\n",
    "print(\"Q75:\", df_quantile(price_col, 0.75))$\n",
    "print(\"IQR:\", df_quantile(price_col, 0.75) - df_quantile(price_col, 0.25))$"
   ],
   "metadata": {
    "outputLabel": "%o251",
    "executionCount": 27
   },
   "execution_count": 27,
   "outputs": [
    {
     "output_type": "execute_result",
     "data": {
      "text/plain": [
       "Q25: 13.875\n",
       "Q50: 15.5\n",
       "Q75: 21.625\n",
       "IQR: 7.75"
      ]
     },
     "metadata": {},
     "execution_count": null
    }
   ]
  },
  {
   "cell_type": "markdown",
   "source": [
