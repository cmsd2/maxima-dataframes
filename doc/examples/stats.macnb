  {
   "cell_type": "markdown",
   "source": [
    "## 5. Filtering Rows\n",
    "\n",
    "Lambda parameter names are automatically matched to column names."
   ],
   "metadata": {}
  },
  {
   "cell_type": "code",
   "source": [
    "/* High-value items: price > 20 */\n",
    "expensive : df_filter(sales, lambda([price], is(price > 20)))$\n",
    "expensive;"
   ],
   "metadata": {
    "outputLabel": "%o280",
    "executionCount": 33
   },
   "execution_count": 33,
   "outputs": [
    {
     "output_type": "execute_result",
     "data": {
      "text/latex": [
       "\\begin{array}{llll} \\textbf{region} & \\textbf{product} & \\textbf{price} & \\textbf{qty} \\\\\\\\ \\textit{str} & \\textit{str} & \\textit{f64} & \\textit{f64} \\\\\\\\ \\hline \\text{North} & \\text{Gadget} & 22.00     & 45.00     \\\\\\\\ \\text{South} & \\text{Gadget} & 21.50     & 50.00     \\\\\\\\ \\text{East} & \\text{Gadget} & 23.00     & 40.00     \\\\\\\\ \\text{North} & \\text{Gadget} & 24.00     & 35.00     \\\\\\\\ \\hline \\text{4 rows} \\times \\text{4 cols} \\end{array}"
      ],
      "text/plain": [
       "\\begin{array}{llll} \\textbf{region} & \\textbf{product} & \\textbf{price} & \\textbf{qty} \\\\\\\\ \\textit{str} & \\textit{str} & \\textit{f64} & \\textit{f64} \\\\\\\\ \\hline \\text{North} & \\text{Gadget} & 22.00     & 45.00     \\\\\\\\ \\text{South} & \\text{Gadget} & 21.50     & 50.00     \\\\\\\\ \\text{East} & \\text{Gadget} & 23.00     & 40.00     \\\\\\\\ \\text{North} & \\text{Gadget} & 24.00     & 35.00     \\\\\\\\ \\hline \\text{4 rows} \\times \\text{4 cols} \\end{array}"
      ]
     },
     "metadata": {},
     "execution_count": null
    }
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "/* Multi-column filter: North region with large orders */\n",
    "north_big : df_filter(sales,\n",
    "              lambda([region, qty], region = \"North\" and is(qty > 50)))$\n",
    "north_big;"
