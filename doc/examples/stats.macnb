   "cell_type": "markdown",
   "source": [
    "## 15. End-to-End Analysis Pipeline\n",
    "\n",
    "A realistic workflow: compute revenue, filter to significant orders,\n",
    "group by product, and summarize."
   ],
   "metadata": {}
  },
  {
   "cell_type": "code",
   "source": [
    "/* 1. Compute revenue */\n",
    "s : df_mutate(sales, \"revenue\", lambda([price, qty], price * qty))$\n",
    "\n",
    "/* 2. Filter to orders over $1000 revenue */\n",
    "s : df_filter(s, lambda([revenue], is(revenue > 1000)))$\n",
    "\n",
    "/* 3. Group by product and summarize */\n",
    "result : df_summarize(\n",
    "  df_group_by(s, \"product\"),\n",
    "  \"orders\",  lambda([price], df_count(price)),\n",
    "  \"revenue\", lambda([revenue], np_sum(revenue)),\n",
    "  \"avg_rev\", lambda([revenue], np_mean(revenue)))$\n",
    "\n",
    "/* 4. Sort by revenue descending */\n",
    "df_arrange(result, \"revenue\", descending);"
   ],
   "metadata": {
    "outputLabel": "%o376",
    "executionCount": 53
   },
   "execution_count": 53,
   "outputs": [
    {
     "output_type": "execute_result",
     "data": {
      "text/latex": [
       "\\begin{array}{llll} \\textbf{product} & \\textbf{orders} & \\textbf{revenue} & \\textbf{avg\\_rev} \\\\\\\\ \\textit{str} & \\textit{f64} & \\textit{f64} & \\textit{f64} \\\\\\\\ \\hline \\text{Widget} & 7.000     & 8855.     & 1265.     \\\\\\\\ \\text{Gadget} & 2.000     & 2175.     & 1088.     \\\\\\\\ \\hline \\text{2 rows} \\times \\text{4 cols} \\end{array}"
      ],
      "text/plain": [
